def twoSum(arr, target):
    i = 0
    j = len(arr) - 1

    while i < j:
        s = arr[i] + arr[j]

        if s == target:
            return [i + 1, j + 1]
        elif s < target:
            i += 1
        else:
            j -= 1

arr = [1, 2, 3, 4, 6, 8, 9]
target = 10

print(twoSum(arr, target))